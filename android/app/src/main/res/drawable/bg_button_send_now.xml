<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="#005511"
                android:endColor="#007722"
                android:angle="270" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="#007733"
                android:endColor="#009944"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#00DD88" />
        </shape>
    </item>
</selector>
