<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A">

    <!-- ════════════════════════════════════════════════════════════════════
         STATE 1: SETUP / PAIRING SCREEN
         ════════════════════════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/setupView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center_horizontal">

            <!-- Header -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="48dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="App Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Universal Clipboard"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pair with your desktop to get started"
                android:textSize="14sp"
                android:textColor="#7B8FA8"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <!-- Primary Action: Scan QR Code -->
            <Button
                android:id="@+id/scanQrButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📷  Scan QR Code to Pair"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_connect"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— OR ENTER MANUALLY —"
                android:textSize="11sp"
                android:textColor="#5577AA"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Connection Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A2A3E"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- IP Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESKTOP IP ADDRESS"
                        android:textSize="10sp"
                        android:textColor="#5577AA"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/ipEditText"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="e.g. 192.168.1.100"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#445566"
                        android:textSize="15sp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="20dp"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                    <!-- Pairing Token -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAIRING TOKEN"
                        android:textSize="10sp"
                        android:textColor="#5577AA"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/tokenEditText"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Paste token from desktop tray"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#445566"
                        android:textSize="15sp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Connect Button -->
            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Connect"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_connect"
                android:layout_marginBottom="28dp" />

            <!-- How to Connect Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#111E2E"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOW TO CONNECT"
                        android:textSize="10sp"
                        android:textColor="#5577AA"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Run UniversalClipboard.exe on your PC\n2. Right-click the tray icon → Copy Pairing Token\n3. Enter your PC's local IP and paste the token above\n4. Tap Connect — clipboard syncs automatically!"
                        android:textSize="13sp"
                        android:textColor="#7788AA"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ════════════════════════════════════════════════════════════════════
         STATE 2: CONNECTED / MAIN USAGE SCREEN
         ════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/connectedView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:visibility="gone">

        <!-- Top spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- App Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Universal Clipboard"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp" />

        <!-- Connected Status Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="16dp">

            <View
                android:id="@+id/connectedDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_connected" />

            <TextView
                android:id="@+id/connectedStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connected"
                android:textSize="13sp"
                android:textColor="#00DD88"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Connected IP address info -->
        <TextView
            android:id="@+id/connectedIpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="192.168.1.100"
            android:textSize="13sp"
            android:textColor="#5577AA"
            android:layout_marginTop="6dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ★ Primary Action: SEND CLIPBOARD ★ -->
        <Button
            android:id="@+id/sendNowButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="📋  Send Clipboard to PC"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_send_large"
            android:layout_marginBottom="14dp" />

        <!-- Seamless Background Auto-Sync Button -->
        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡ Enable Seamless Auto-Sync"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#00DD88"
            android:background="@drawable/bg_status_pill"
            android:layout_marginBottom="12dp" />

        <!-- Last Sync Info -->
        <TextView
            android:id="@+id/lastSyncText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No sync yet"
            android:textSize="12sp"
            android:textColor="#445566"
            android:layout_marginBottom="8dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Disconnect (small text-button, placed far from send) -->
        <TextView
            android:id="@+id/disconnectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnect"
            android:textSize="13sp"
            android:textColor="#667788"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════
         STATE 3: DISCONNECTED / CONNECTION LOST SCREEN
         ════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/disconnectedView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:visibility="gone">

        <!-- Top spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- App Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Universal Clipboard"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp" />

        <!-- Disconnected Status Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_disconnected" />

            <TextView
                android:id="@+id/disconnectedStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection Lost"
                android:textSize="13sp"
                android:textColor="#AABBCC"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Disconnected IP info -->
        <TextView
            android:id="@+id/disconnectedIpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="192.168.1.100"
            android:textSize="13sp"
            android:textColor="#5577AA"
            android:layout_marginTop="6dp" />

        <!-- Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Could not reach your desktop.\nMake sure UniversalClipboard is running."
            android:textSize="13sp"
            android:textColor="#667788"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="3dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Reconnect Button -->
        <Button
            android:id="@+id/reconnectButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Reconnect"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_reconnect"
            android:layout_marginBottom="16dp" />

        <!-- Change Device link -->
        <TextView
            android:id="@+id/changeDeviceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Device"
            android:textSize="13sp"
            android:textColor="#667788"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
